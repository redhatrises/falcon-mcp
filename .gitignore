# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.DS_Store
*.vscode

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

bin/
dist/

# Environments
.env
env.bak/

# Local planning / scratch docs
#  Implementation plans, design scratch, and prompt sequences live here so they
#  stay OUT of docs/ (which is published and markdown-linted by CI).
/plans/

# Local testing ground (agent-level tests, claude -p harnesses, scratch scripts)
/local/

# AI Assistants
#  Various AI coding assistants create local cache, settings, and conversation history
#  These contain user-specific data and should not be committed to version control
.cursorignore
.cursorindexingignore
.claude/
CLAUDE.md
.anthropic/
.openai/
.codeium/
.tabnine/
.github-copilot/
.roo/
.aider/
.aider*
.clinerules/
.mcp.json
memory-bank/
